@startuml
title Diagrama de Clases de Diseño - CLI HTTP (Auth + Aulas)

package "CLI Commands (Click)" {
    class CLIApp {
        +api_client: APIClient
        +token_manager: TokenManager
    }

    class AuthCommands {
        +login()
        +logout()
    }

    class AulaCommands {
        +list()
        +create()
        +edit(id)
        +delete(id)
    }
}

package "CLI Infrastructure" {
    class APIClient {
        +base_url: str
        +session: requests.Session
        +post(endpoint, data): Response
        +get(endpoint, params): Response
        +put(endpoint, data): Response
        +delete(endpoint): Response
    }

    class TokenManager {
        +token_file: str
        +save_token(token: str)
        +get_token(): str
        +clear_token()
    }

    class OutputFormatter {
        +format_table(data): str
        +format_json(data): str
        +format_error(message): str
    }
}

package "Backend FastAPI (Reutilizado)" <<Cloud>> {
    class "POST /token" as LoginEndpoint {
        +username: str
        +password: str
        --
        +return: Token
    }

    class "GET /aulas" as ListAulasEndpoint {
        +skip: int
        +limit: int
        --
        +return: List[AulaResponse]
    }

    class "POST /aulas" as CreateAulaEndpoint {
        +body: AulaCreate
        --
        +return: AulaResponse
    }

    class "PUT /aulas/{id}" as UpdateAulaEndpoint {
        +id: int
        +body: AulaUpdate
        --
        +return: AulaResponse
    }

    class "DELETE /aulas/{id}" as DeleteAulaEndpoint {
        +id: int
        --
        +return: bool
    }
}

CLIApp *-- APIClient
CLIApp *-- TokenManager
CLIApp *-- OutputFormatter

AuthCommands ..> APIClient : consume >
AuthCommands ..> TokenManager : gestiona >

AulaCommands ..> APIClient : consume >
AulaCommands ..> TokenManager : usa >
AulaCommands ..> OutputFormatter : formatea >

APIClient ..> LoginEndpoint : POST /token
APIClient ..> ListAulasEndpoint : GET /aulas
APIClient ..> CreateAulaEndpoint : POST /aulas
APIClient ..> UpdateAulaEndpoint : PUT /aulas/{id}
APIClient ..> DeleteAulaEndpoint : DELETE /aulas/{id}

note right of "Backend FastAPI (Reutilizado)"
  **Backend completo reutilizado:**
  - AuthService
  - AulaService
  - Repositories
  - Models (SQLAlchemy)
  - Base de datos SQLite
end note

@enduml
