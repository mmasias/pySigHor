  class UsuarioService {
    autenticar(username, password) : Usuario
  }
  class AsignacionService {
    obtener_asignaciones(profesor_id) : List<Curso>
    actualizar_asignaciones(profesor_id, curso_ids) : List<Curso>
  }
  class PreferenciaService {
    obtener_preferencias(profesor_id) : List<PreferenciaResponse>
