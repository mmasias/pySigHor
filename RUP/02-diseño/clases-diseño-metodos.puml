package Repositorio {
  class AulaRepository {
    get_all(skip, limit) : List<Aula>
    get_by_id(aula_id) : Aula
    get_by_nombre(nombre) : Aula
    create(aula_data) : Aula
    update(aula, aula_data) : Aula
    set_recursos(aula, ids_recursos) : Aula
    delete(aula) : void
  }
  class CursoRepository {
    get_all(skip, limit) : List<Curso>
    get_by_id(curso_id) : Curso
    get_by_nombre(nombre) : Curso
    get_by_programa(programa_id) : List<Curso>
    create(curso_data) : Curso
    update(curso, curso_data) : Curso
    delete(curso) : void
  }
  class EdificioRepository {
    get_all(skip, limit) : List<Edificio>
    get_by_id(edificio_id) : Edificio
    get_by_nombre(nombre) : Edificio
    create(edificio_data) : Edificio
    update(edificio, edificio_data) : Edificio
    delete(edificio) : void
  }
  class ProfesorRepository {
    get_all(skip, limit) : List<Profesor>
    get_by_id(profesor_id) : Profesor
    get_by_correo(correo) : Profesor
    create(profesor_data) : Profesor
    update(profesor, profesor_data) : Profesor
    delete(profesor) : void
  }
  class ProgramaRepository {
    get_all(skip, limit) : List<Programa>
    get_by_id(programa_id) : Programa
    get_by_nombre(nombre) : Programa
    create(programa_data) : Programa
    update(programa, programa_data) : Programa
    delete(programa) : void
  }
  class RecursoRepository {
    get_all(skip, limit) : List<Recurso>
    get_by_id(recurso_id) : Recurso
    get_by_nombre(nombre) : Recurso
    create(recurso_data) : Recurso
    update(recurso, recurso_data) : Recurso
    delete(recurso) : void
  }
  class UsuarioRepository {
    get_by_username(username) : Usuario
    create(data) : Usuario
  }
  class AsignacionRepository {
    get_cursos_asignados(profesor_id) : List<Curso>
    replace_all(profesor_id, curso_ids) : List<Curso>
  }
  class PreferenciaRepository {
    get_by_profesor(profesor_id) : List<ProfesorRecurso>
    replace_all(profesor_id, recurso_ids) : List<ProfesorRecurso>
  }
}

