left to right direction

package Modelo {
  class Base
  class Aula {
    id : int
    codigo : str
    nombre : str
    capacidad : int
    tipo : str
    observaciones : str
    especial : bool
    bloqueada : bool
    id_edificio : int
    created_at : datetime
    updated_at : datetime
  }
  class Curso {
    id : int
    nombre : str
    descripcion : str
    creditos : int
    horas : int
    id_programa : int
    created_at : datetime
    updated_at : datetime
  }
  class Edificio {
    id : int
    nombre : str
    direccion : str
    created_at : datetime
    updated_at : datetime
  }
  class Profesor {
    id : int
    nombres : str
    apellidos : str
    correo : str
    telefono : str
    observaciones : str
    created_at : datetime
    updated_at : datetime
  }
  class ProfesorRecurso {
    profesor_id : int
    recurso_id : int
    prioridad : int
  }
  class Programa {
    id : int
    nombre : str
    descripcion : str
    activo : bool
    created_at : datetime
    updated_at : datetime
  }
  class Recurso {
    id : int
    nombre : str
    descripcion : str
    created_at : datetime
    updated_at : datetime
  }
  class Usuario {
    id : int
    username : str
    hashed_password : str
    rol : str
    activo : bool
    created_at : datetime
  }
}

