@startuml
title Diagrama de Secuencia: Eliminar Aula (CLI Standalone)

actor Administrador as admin
participant "CLI\n(AulaCommand)" as cli
participant "TokenManager" as token
participant "AulaService" as service
participant "AulaRepository" as repo
participant "SQLite" as db

admin -> cli: sighor aulas delete 1
activate cli

cli -> token: load_token()
activate token
token --> cli: token (JWT)
deactivate token

cli -> admin: confirm: ¿Eliminar aula 1? [y/N]
admin -> cli: "y"

cli -> service: delete(1)
activate service

service -> repo: delete(1)
activate repo

repo -> repo: find_by_id(1)

repo -> db: SELECT * FROM aulas WHERE id = 1
activate db
db --> repo: Aula(id=1, ...)
deactivate db

repo -> db: DELETE FROM aulas WHERE id = 1
activate db
db --> repo: OK
deactivate db

repo -> db: COMMIT
activate db
db --> repo: OK
deactivate db

repo --> service: True
deactivate repo

service --> cli: True
deactivate service

cli --> admin: "Aula eliminada correctamente"
deactivate cli

@enduml
