@startuml
title Diagrama de Secuencia: Editar Aula (CLI Standalone)

actor Administrador as admin
participant "CLI\n(AulaCommand)" as cli
participant "TokenManager" as token
participant "AulaService" as service
participant "AulaRepository" as repo
participant "SQLite" as db

admin -> cli: sighor aulas edit 1
activate cli

cli -> token: load_token()
activate token
token --> cli: token (JWT)
deactivate token

cli -> service: get_by_id(1)
activate service

service -> repo: find_by_id(1)
activate repo

repo -> db: SELECT * FROM aulas WHERE id = 1
activate db
db --> repo: Aula(id=1, nombre="A101", capacidad=30, edificio="A")
deactivate db

repo --> service: Aula object
deactivate repo

service --> cli: {"id": 1, "nombre": "A101", "capacidad": 30, "edificio": "A"}
deactivate service

cli -> admin: prompt: Nombre [A101]
admin -> cli: "A101-B"

cli -> admin: prompt: Capacidad [30]
admin -> cli: 35

cli -> admin: prompt: Edificio [A]
admin -> cli: (Enter - mantiene "A")

cli -> service: update(1, {"nombre": "A101-B", "capacidad": 35, "edificio": "A"})
activate service

service -> repo: find_by_id(1)
activate repo
repo -> db: SELECT * FROM aulas WHERE id = 1
activate db
db --> repo: Aula object
deactivate db
repo --> service: Aula object
deactivate repo

service -> service: validate_aula(data)

service -> service: aula.nombre = "A101-B"\naula.capacidad = 35\naula.edificio = "A"

service -> repo: update(aula)
activate repo

repo -> db: UPDATE aulas SET nombre=?, capacidad=?, edificio=?\nWHERE id=1
activate db
db --> repo: OK
deactivate db

repo --> service: Aula(id=1, nombre="A101-B", ...)
deactivate repo

service --> cli: {"id": 1, "nombre": "A101-B", "capacidad": 35, "edificio": "A"}
deactivate service

cli --> admin: "Aula actualizada correctamente"
deactivate cli

@enduml
