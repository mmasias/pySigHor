@startuml openBuildings

skinparam linetype polyline

state openBuildings as "openBuildings()" {

    state " " as ShowingList
    state " " as FilteringList

    [*] -[#green]-> ShowingList 
    note on link
    <b>Administrator</b> requests abrir edificios
    end note    
    
    ShowingList -[#green]-> FilteringList
    note on link
    <b>System</b> presents building list
    • ID, nombre de cada edificio
    • Permite requestsr filter list
    • Permite requestsr create new
    • Permite requestsr delete
    • Permite requestsr edit
    end note
    
    FilteringList -[#green]-> FilteringList
    note on link
    <b>Administrator</b> requests filter list
    <b>System</b> presents filtered list
    end note
    
    FilteringList -[#green]-> [*]
    note on link
    <b>Administrator</b> requests one of the options
    end note
}

abrirEdificios -[#green]-> BUILDING_OPEN
note on link
editBuilding()
end note

abrirEdificios -[#green]-> BUILDING_OPEN
note on link
createBuilding()
end note

abrirEdificios -[#green]-> BUILDINGS_OPEN
note on link
deleteBuilding()
end note

abrirEdificios -[#green]-> SYSTEM_AVAILABLE
note on link
completeManagement()
end note

@enduml