@startuml createCourse

skinparam linetype polyline

state createCourse as "createCourse()" {

    state " " as RequestingData
    state " " as CreandoCurso

    [*] -[#green]-> RequestingData 
    note on link
    <b>Administrator</b> requests create new
    end note    
    
    RequestingData -[#green]-> CreandoCurso
    note on link
    <b>System</b> presents solicitud de datos mínimos del curso
    • Nombre del curso (obligatorio)
    • Permite requestsr crear curso
    • Permite requestsr cancelar creación
    end note
    
    CreandoCurso -[#green]-> [*]
    note on link
    <b>Administrator</b> proporciona datos mínimos
    <b>System</b> crea curso y transfiere a edición
    end note
}

crearCurso -[#green]-> COURSE_OPEN
note on link
editarCurso(cursoNuevo)
end note

crearCurso -[#blue]-> COURSES_OPEN
note on link
cancelar creación
end note

@enduml