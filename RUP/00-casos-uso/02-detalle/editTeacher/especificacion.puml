@startuml editTeacher

skinparam linetype polyline

state editTeacher as "editTeacher()" {

    state " " as EditingData
    state " " as SavingData 

    [*] -[#green]-> EditingData 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditingData -[#green]-> SavingData
    note on link
    <b>System</b> presents editing data
    • Code, names, surnames of teacher
    • Email, phone
    • Teacher observations
    
    <b>System</b> allows request:
    • modify fields
    • save teacher
    • cancel editing
    end note
    
    SavingData -[#green]-> EditingData
    note on link
    <b>Administrator</b> requests modify fields
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests save and exit
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancel editing
    end note

}

editTeacher -[#green]-> TEACHERS_OPEN
note on link
openTeachers()
end note

editTeacher -[#red]-> TEACHERS_OPEN
note on link
cancel editing
end note

@enduml