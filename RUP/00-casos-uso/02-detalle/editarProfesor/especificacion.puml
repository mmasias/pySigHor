@startuml editTeacher

skinparam linetype polyline

state editTeacher as "editTeacher()" {

    state " " as EditandoDatos
    state " " as SavingData 

    [*] -[#green]-> EditandoDatos 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditandoDatos -[#green]-> SavingData
    note on link
    <b>System</b> presents datos de edición
    • Código, nombres, apellidos del profesor
    • Correo electrónico, teléfono
    • Observaciones del profesor
    
    <b>System</b> permite requestsr:
    • modificar campos
    • guardar profesor
    • cancelar edición
    end note
    
    SavingData -[#green]-> EditandoDatos
    note on link
    <b>Administrator</b> requests modificar campos
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests guardar y salir
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancelar edición
    end note

}

editarProfesor -[#green]-> TEACHERS_OPEN
note on link
openTeachers()
end note

editarProfesor -[#red]-> TEACHERS_OPEN
note on link
cancelar edición
end note

@enduml