@startuml editBuilding

skinparam linetype polyline

state editBuilding as "editBuilding()" {

    state " " as EditingData
    state " " as SavingData 

    [*] -[#green]-> EditingData 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditingData -[#green]-> SavingData
    note on link
    <b>System</b> presents editing data
    • Code, name of building
    • Location, description
    • Building observations
    
    <b>System</b> allows request:
    • modify fields
    • save building
    • cancel editing
    end note
    
    SavingData -[#green]-> EditingData
    note on link
    <b>Administrator</b> requests modify fields
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests save and exit
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancel editing
    end note

}

editBuilding -[#green]-> BUILDINGS_OPEN
note on link
openBuildings()
end note

editBuilding -[#red]-> BUILDINGS_OPEN
note on link
cancel editing
end note

@enduml