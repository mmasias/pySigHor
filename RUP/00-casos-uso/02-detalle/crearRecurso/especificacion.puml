@startuml createResource
skinparam linetype polyline

state createResource as "createResource()" {
    state " " as RequiringData
    state " " as ProvidingData
    state c <<choice>>
    
    [*] -[#green]-> RequiringData
    note on link
    <b>Administrator</b> requests crear recurso
    end note
    
    RequiringData -[#green]-> ProvidingData
    note on link
    <b>System</b> permite introducir
    • código del recurso
    • nombre del recurso
    end note
    
    ProvidingData -[#green]-> c
    note on link
    <b>Administrator</b> introduce
    • código del recurso
    • nombre del recurso
    end note
    
    c -[#red]-> RequiringData
    note on link
    código del recurso
    ya existe
    end note
    
    c -[#green]-> [*]
    note on link
    recurso creado con datos mínimos
    transferir a editResource()
    end note
}

createResource -[#green]-> RECOURSE_OPEN
note on link
editResource()
end note

@enduml