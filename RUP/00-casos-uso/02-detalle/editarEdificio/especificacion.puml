@startuml editBuilding

skinparam linetype polyline

state editBuilding as "editBuilding()" {

    state " " as EditandoDatos
    state " " as SavingData 

    [*] -[#green]-> EditandoDatos 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditandoDatos -[#green]-> SavingData
    note on link
    <b>System</b> presents datos de edición
    • Código, nombre del edificio
    • Ubicación, descripción
    • Observaciones del edificio
    
    <b>System</b> permite requestsr:
    • modificar campos
    • guardar edificio
    • cancelar edición
    end note
    
    SavingData -[#green]-> EditandoDatos
    note on link
    <b>Administrator</b> requests modificar campos
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests guardar y salir
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancelar edición
    end note

}

editarEdificio -[#green]-> BUILDINGS_OPEN
note on link
openBuildings()
end note

editarEdificio -[#red]-> BUILDINGS_OPEN
note on link
cancelar edición
end note

@enduml