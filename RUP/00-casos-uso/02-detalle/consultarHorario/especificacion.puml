@startuml viewSchedule

skinparam linetype polyline

state viewSchedule as "viewSchedule()" {

    state " " as RequiringConsultation
    state " " as ProvidingSchedule
    state c <<choice>>

    [*] -[#green]-> RequiringConsultation 
    note on link
    <b>Administrator</b> requests consultar horario
    end note    
    
    RequiringConsultation -[#green]-> ProvidingSchedule
    note on link
    <b>System</b> presents
    • horario generado
    • mensaje si no hay horario
    end note
    
    ProvidingSchedule -[#green]-> c
    note on link
    <b>Administrator</b> requests
    • continuar consultando
    • salir de consulta
    end note
    
    c -[#green]-> ProvidingSchedule
    note on link
    continuar navegando
    end note

    c -[#green]-> [*]
    note on link
    salir de consulta
    end note
}

consultarHorario -[#green]-> SYSTEM_AVAILABLE
note on link
completeManagement()
end note

@enduml