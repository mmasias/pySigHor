@startuml editClassroom

skinparam linetype polyline

state editClassroom as "editClassroom()" {

    state " " as EditandoDatos
    state " " as SavingData 

    [*] -[#green]-> EditandoDatos 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditandoDatos -[#green]-> SavingData
    note on link
    <b>System</b> presents datos de edición
    • Código, nombre del aula
    • Edificio asociado, capacidad
    • Tipo de aula, recursos
    • Observaciones del aula
    
    <b>System</b> permite request:
    • modificar campos
    • guardar aula
    • cancelar edición
    end note
    
    SavingData -[#green]-> EditandoDatos
    note on link
    <b>Administrator</b> requests modificar campos
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests guardar y salir
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancelar edición
    end note

}

editClassroom -[#green]-> CLASSROOMS_OPEN
note on link
openClassrooms()
end note

editClassroom -[#red]-> CLASSROOMS_OPEN
note on link
cancelar edición
end note

@enduml