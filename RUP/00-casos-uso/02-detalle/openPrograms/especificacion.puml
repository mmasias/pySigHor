@startuml openPrograms

skinparam linetype polyline

state openPrograms as "openPrograms()" {

    state " " as ShowingList
    state " " as FilteringList

    [*] -[#green]-> ShowingList 
    note on link
    <b>Administrator</b> requests open programs
    end note    
    
    ShowingList -[#green]-> FilteringList
    note on link
    <b>System</b> presents program list
    • Code, name, description of each program
    <b>System</b> allows
    • request filter list
    • request create new
    • request delete
    • request edit
    end note
    
    FilteringList -[#green]-> FilteringList
    note on link
    <b>Administrator</b> requests filter list
    <b>System</b> presents filtered list
    end note
    
    FilteringList -[#green]-> [*]
    note on link
    <b>Administrator</b> requests one of the options
    end note
}

openPrograms -[#green]-> PROGRAM_OPEN
note on link
editProgram()
end note

openPrograms -[#green]-> PROGRAM_OPEN
note on link
createProgram()
end note

openPrograms -[#green]-> PROGRAMS_OPEN
note on link
deleteProgram()
end note

openPrograms -[#green]-> SYSTEM_AVAILABLE
note on link
completeManagement()
end note

@enduml