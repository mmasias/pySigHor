@startuml openTeachers

skinparam linetype polyline

state openTeachers as "openTeachers()" {

    state " " as ShowingList
    state " " as FilteringList

    [*] -[#green]-> ShowingList 
    note on link
    <b>Administrator</b> requests open teachers
    end note    
    
    ShowingList -[#green]-> FilteringList
    note on link
    <b>System</b> presents teacher list
    • Code, name, surnames of each teacher
    <b>System</b> allows
    • request filter list
    • request create new
    • request delete
    • request edit
    end note
    
    FilteringList -[#green]-> FilteringList
    note on link
    <b>Administrator</b> requests filter list
    <b>System</b> presents filtered list
    end note
    
    FilteringList -[#green]-> [*]
    note on link
    <b>Administrator</b> requests one of the options
    end note
}

openTeachers -[#green]-> TEACHER_OPEN
note on link
editTeacher()
end note

openTeachers -[#green]-> TEACHER_OPEN
note on link
createTeacher()
end note

openTeachers -[#green]-> TEACHERS_OPEN
note on link
deleteTeacher()
end note

openTeachers -[#green]-> SYSTEM_AVAILABLE
note on link
completeManagement()
end note

@enduml