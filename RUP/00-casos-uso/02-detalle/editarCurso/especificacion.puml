@startuml editCourse

skinparam linetype polyline

state editCourse as "editCourse()" {

    state " " as EditandoDatos
    state " " as SavingData 

    [*] -[#green]-> EditandoDatos 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditandoDatos -[#green]-> SavingData
    note on link
    <b>System</b> presents datos de edición
    • Código, nombre, descripción del curso
    • Créditos, horas teóricas, horas prácticas
    • Programa académico asociado
    
    <b>System</b> permite request:
    • modificar campos
    • guardar curso
    • cancelar edición
    end note
    
    SavingData -[#green]-> EditandoDatos
    note on link
    <b>Administrator</b> requests modificar campos
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests guardar y salir
    end note

    SavingData -[#red]-> [*]
    note on link
    <b>Administrator</b> requests cancelar edición
    end note

}

editarCurso -[#green]-> COURSES_OPEN
note on link
openCourses()
end note

editarCurso -[#red]-> COURSES_OPEN
note on link
cancelar edición
end note

@enduml