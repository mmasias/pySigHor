@startuml editProgram

skinparam linetype polyline

state editProgram as "editProgram()" {

    state " " as EditandoDatos
    state " " as SavingData

    [*] -[#green]-> EditandoDatos 
    note on link
    <b>Administrator</b> requests edit
    end note    
    
    EditandoDatos -[#green]-> SavingData
    note on link
    <b>System</b> presents formulario de edición
    • Código, nombre, descripción del programa
    • Permite request modificar campos
    • Permite request guardar programa
    • Permite request cancelar edición
    end note
    
    SavingData -[#green]-> EditandoDatos
    note on link
    <b>Administrator</b> requests modificar campos (opcional)
    <b>System</b> permite modificar información
    end note
    
    SavingData -[#green]-> [*]
    note on link
    <b>Administrator</b> requests guardar y salir
    end note
}

editarPrograma -[#green]-> EditandoDatos
note on link
<b>Administrator</b> requests continuar editando
<b>System</b> mantiene formulario activo
end note

editarPrograma -[#green]-> PROGRAMS_OPEN
note on link
openPrograms()
end note

editarPrograma -[#blue]-> PROGRAMS_OPEN
note on link
cancelar edición
end note

@enduml