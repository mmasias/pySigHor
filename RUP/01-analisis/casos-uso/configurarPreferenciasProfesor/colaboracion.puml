@startuml configureTeacherPreferences-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":Profesor Abierto" as ProfesorAbierto
rectangle #CDEBA5 ":Collaboration EditTeacher" as EditTeacher

package configureTeacherPreferences as "configureTeacherPreferences()" {
    rectangle #629EF9 ConfigurePreferencesProfesorView
    rectangle #b5bd68 PreferenciasProfesorController
    rectangle #F2AC4E TeacherRepository
    rectangle #F2AC4E ResourceRepository
    rectangle #F2AC4E Teacher
    rectangle #F2AC4E PreferenciasRecurso
    rectangle #F2AC4E Resource
}

ProfesorAbierto -r-> ConfigurePreferencesProfesorView: configurarPreferenciasProfesor(profesorId)

ConfigurePreferencesProfesorView -d-> PreferenciasProfesorController: cargarPreferenciasProfesor(profesorId)

PreferenciasProfesorController --> TeacherRepository: obtenerConPreferencias(profesorId) : Profesor
PreferenciasProfesorController --> ResourceRepository: obtenerRecursosDisponibles() : List<Resource>

ConfigurePreferencesProfesorView --> PreferenciasProfesorController: modificarOrdenPrioridad(nuevoOrden) : boolean

PreferenciasProfesorController --> TeacherRepository: actualizarPreferencias(profesorId, preferencias) : boolean

TeacherRepository -- Profesor
TeacherRepository -- PreferenciasRecurso
ResourceRepository -- Recurso

ConfigurePreferencesProfesorView ..> EditTeacher: <<include>> editarProfesor(profesorId)

@enduml