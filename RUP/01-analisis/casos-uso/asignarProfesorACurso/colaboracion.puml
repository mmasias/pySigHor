@startuml assignTeacherToCourse-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":Profesor Abierto" as ProfesorAbierto
rectangle #CDEBA5 ":Collaboration EditTeacher" as EditTeacher

package assignTeacherToCourse as "assignTeacherToCourse()" {
    rectangle #629EF9 AssignTeacherACursoView
    rectangle #b5bd68 AsignacionProfesorCursoController
    rectangle #F2AC4E TeacherRepository
    rectangle #F2AC4E CourseRepository
    rectangle #F2AC4E Teacher
    rectangle #F2AC4E AsignacionProfesorCurso
    rectangle #F2AC4E Course
}

ProfesorAbierto -r-> AssignTeacherACursoView: asignarProfesorACurso(profesorId)

AssignTeacherACursoView -d-> AsignacionProfesorCursoController: cargarAsignacionesProfesor(profesorId)

AsignacionProfesorCursoController --> TeacherRepository: obtenerConAsignaciones(profesorId) : Teacher
AsignacionProfesorCursoController --> CourseRepository: obtenerCursosDisponibles() : List<Course>
AsignacionProfesorCursoController --> CourseRepository: obtenerCursosAsignados(profesorId) : List<Course>

AssignTeacherACursoView --> AsignacionProfesorCursoController: asignarCurso(profesorId, cursoId) : boolean
AssignTeacherACursoView --> AsignacionProfesorCursoController: desasignarCurso(profesorId, cursoId) : boolean

AsignacionProfesorCursoController --> TeacherRepository: actualizarAsignaciones(profesorId, asignaciones) : boolean

TeacherRepository -- Profesor
TeacherRepository -- AsignacionProfesorCurso
CourseRepository -- Curso

AssignTeacherACursoView ..> EditTeacher: <<include>> editarProfesor(profesorId)

@enduml