@startuml generateSchedule-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":System Available" as SystemAvailable
rectangle #CDEBA5 ":Collaboration ViewSchedule" as ViewSchedule
rectangle #CDEBA5 ":Collaboration CompletarGestion" as CompletarGestion

package generateSchedule as "generateSchedule()" {
    rectangle #629EF9 GenerateScheduleView
    rectangle #b5bd68 ScheduleController
    rectangle #F2AC4E ScheduleRepository
    rectangle #F2AC4E ScheduleGenerator
    rectangle #F2AC4E Validador
    rectangle #F2AC4E Schedule
}

SystemAvailable --> GenerateScheduleView: generateSchedule()

GenerateScheduleView -d-> ScheduleController: procesarGeneracion() : ResultadoGeneracion

ScheduleController --> Validador: verificarDatosMinimos() : boolean

ScheduleController --> ScheduleRepository: existeHorario() : boolean
ScheduleController --> ScheduleRepository: verificarDatosDisponibles() : DatosDisponibles

ScheduleController --> HorarioGenerator: ejecutarGeneracion() : Horario

HorarioGenerator --> ScheduleRepository: cargarDatosMaestros() : DatosMaestros
HorarioGenerator --> ScheduleRepository: guardarHorario(horario) : boolean

ScheduleRepository -- Horario
ScheduleRepository -- Validador

GenerateScheduleView ..> ViewSchedule: <<include>> viewSchedule() [generación exitosa]
GenerateScheduleView ..> CompletarGestion: <<include>> completeManagement() [cancelación/error]

@enduml