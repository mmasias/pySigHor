@startuml generateSchedule-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":System Available" as SystemAvailable
rectangle #CDEBA5 ":Collaboration ViewSchedule" as ViewSchedule
rectangle #CDEBA5 ":Collaboration CompleteManagement" as CompleteManagement

package generateSchedule as "generateSchedule()" {
    rectangle #629EF9 GenerateScheduleView
    rectangle #b5bd68 ScheduleController
    rectangle #F2AC4E ScheduleRepository
    rectangle #F2AC4E ScheduleGenerator
    rectangle #F2AC4E Validator
    rectangle #F2AC4E Schedule
}

SystemAvailable --> GenerateScheduleView: generateSchedule()

GenerateScheduleView -d-> ScheduleController: processGeneration() : GenerationResult

ScheduleController --> Validator: verifyMinimalData() : boolean

ScheduleController --> ScheduleRepository: scheduleExists() : boolean
ScheduleController --> ScheduleRepository: verifyAvailableData() : AvailableData

ScheduleController --> ScheduleGenerator: executeGeneration() : Schedule

ScheduleGenerator --> ScheduleRepository: loadMasterData() : MasterData
ScheduleGenerator --> ScheduleRepository: saveSchedule(schedule) : boolean

ScheduleRepository -- Schedule
ScheduleRepository -- Validator

GenerateScheduleView ..> ViewSchedule: <<include>> viewSchedule() [successful generation]
GenerateScheduleView ..> CompleteManagement: <<include>> completeManagement() [cancellation/error]

@enduml