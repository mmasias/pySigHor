@startuml assignTeacherToCourse-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":Teacher Open" as TeacherOpen
rectangle #CDEBA5 ":Collaboration EditTeacher" as EditTeacher

package assignTeacherToCourse as "assignTeacherToCourse()" {
    rectangle #629EF9 AssignTeacherToCourseView
    rectangle #b5bd68 TeacherCourseAssignmentController
    rectangle #F2AC4E TeacherRepository
    rectangle #F2AC4E CourseRepository
    rectangle #F2AC4E Teacher
    rectangle #F2AC4E TeacherCourseAssignment
    rectangle #F2AC4E Course
}

TeacherOpen -r-> AssignTeacherToCourseView: assignTeacherToCourse(teacherId)

AssignTeacherToCourseView -d-> TeacherCourseAssignmentController: loadTeacherAssignments(teacherId)

TeacherCourseAssignmentController --> TeacherRepository: getWithAssignments(teacherId) : Teacher
TeacherCourseAssignmentController --> CourseRepository: getAvailableCourses() : List<Course>
TeacherCourseAssignmentController --> CourseRepository: getAssignedCourses(teacherId) : List<Course>

AssignTeacherToCourseView --> TeacherCourseAssignmentController: assignCourse(teacherId, courseId) : boolean
AssignTeacherToCourseView --> TeacherCourseAssignmentController: unassignCourse(teacherId, courseId) : boolean

TeacherCourseAssignmentController --> TeacherRepository: updateAssignments(teacherId, assignments) : boolean

TeacherRepository -- Teacher
TeacherRepository -- TeacherCourseAssignment
CourseRepository -- Course

AssignTeacherToCourseView ..> EditTeacher: <<include>> editTeacher(teacherId)

@enduml