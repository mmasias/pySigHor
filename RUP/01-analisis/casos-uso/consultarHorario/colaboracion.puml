@startuml viewSchedule-analysis
skinparam linetype polyline

rectangle #CDEBA5 ":System Available" as SystemAvailable
rectangle #CDEBA5 ":Horario Abierto" as HorarioAbierto
rectangle #CDEBA5 ":Collaboration GenerateSchedule" as GenerateSchedule
rectangle #CDEBA5 ":Collaboration CompletarGestion" as CompletarGestion

package viewSchedule as "viewSchedule()" {
    rectangle #629EF9 ViewScheduleView
    rectangle #b5bd68 ScheduleController
    rectangle #F2AC4E ScheduleRepository
    rectangle #F2AC4E Schedule
}

SystemAvailable --> ViewScheduleView: viewSchedule()
HorarioAbierto --> ViewScheduleView: viewSchedule()
GenerateSchedule --> ViewScheduleView: consultarHorario(horarioGenerado)

ViewScheduleView -d-> ScheduleController: procesarConsulta() : ResultadoConsulta

ScheduleController --> ScheduleRepository: cargarHorario() : Horario
ScheduleController --> ScheduleRepository: existeHorario() : boolean

ScheduleRepository --> Horario: obtenerDatosCompletos() : DatosHorario

ScheduleRepository -- Horario

ViewScheduleView ..> CompletarGestion: <<include>> completeManagement() [al salir]

@enduml